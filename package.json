{
  "name": "helmd",
  "version": "0.5.3-fork.8",
  "private": true,
  "type": "module",
  "main": "dist/health.js",
  "types": "dist/health.d.ts",
  "exports": {
    ".": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./agent": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset.generated.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.3-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
    "test:preset": "node scripts/test-gen-preset.mjs",
    "test:checks": "node scripts/checks/run-all.mjs",
    "gen:refs": "node scripts/gen-references-index.mjs",
    "check:refs": "node scripts/gen-references-index.mjs --check",
    "team:eval": "node scripts/team-eval.mjs",
    "test:pack": "node scripts/verify-pack.mjs",
    "sync:root": "node scripts/sync-root-shim.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test:checks"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
